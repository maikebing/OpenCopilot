<UserControl x:Class="OpenCopilot.ToolWindows.CopilotChatWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="400"
             Loaded="CopilotChatWindowControl_Loaded"
             Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}">

    <UserControl.Resources>
        <Style x:Key="ThemedFlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemedBorderBrush}"/>
        </Style>

        <SolidColorBrush x:Key="ThemedBorderBrush" Color="{DynamicResource {x:Static SystemColors.ControlDarkColorKey}}"/>
        <SolidColorBrush x:Key="ThemedPlaceholderBrush" Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}"/>

        <Style x:Key="ThemedSelectorComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemedBorderBrush}"/>
        </Style>

        <Style x:Key="ThemedInputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemedBorderBrush}"/>
        </Style>

        <Style x:Key="ThemedCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemedBorderBrush}"/>
        </Style>

        <Style x:Key="ThemedPrimaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}"/>
        </Style>

        <Style x:Key="ThemedSecondaryText" TargetType="TextBlock" BasedOn="{StaticResource ThemedPrimaryText}">
            <Setter Property="Opacity" Value="0.78"/>
        </Style>

        <Style x:Key="ThemedMutedText" TargetType="TextBlock" BasedOn="{StaticResource ThemedPrimaryText}">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style x:Key="ThemedSenderLabel" TargetType="TextBlock" BasedOn="{StaticResource ThemedSecondaryText}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="10,4,10,0"/>
        </Style>

        <Style x:Key="ThemedTypingIndicatorText" TargetType="TextBlock" BasedOn="{StaticResource ThemedSecondaryText}">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>

        <Style x:Key="SenderLabel" TargetType="TextBlock" BasedOn="{StaticResource ThemedSenderLabel}"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}" Padding="10,6" BorderBrush="{StaticResource ThemedBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="StatusLabel"
                           Style="{StaticResource ThemedPrimaryText}"
                           FontSize="11"
                           Margin="0,0,0,6"
                           Text="OpenCopilot · No provider configured"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SessionSelector"
                              Grid.Column="0"
                              Style="{StaticResource ThemedSelectorComboBox}"
                              IsEditable="True"
                              MinWidth="220"
                              DisplayMemberPath="Title"
                              SelectionChanged="SessionSelector_SelectionChanged"
                              FontSize="11"
                              Padding="4,2"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource ThemedFlatButton}"
                            Content="重命名"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            FontSize="11"
                            Click="RenameSessionButton_Click"/>
                    <Button Grid.Column="2"
                            Style="{StaticResource ThemedFlatButton}"
                            Content="删除"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            FontSize="11"
                            Click="DeleteSessionButton_Click"/>
                    <Button x:Name="NewChatButton"
                            Grid.Column="3"
                            Style="{StaticResource ThemedFlatButton}"
                            Content="新建"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            FontSize="11"
                            Click="NewChatButton_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Chat history -->
        <ScrollViewer x:Name="ChatScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}">
            <ItemsControl x:Name="MessageList" Margin="0,8,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SenderLabel}"
                                       Text="{Binding Sender}"
                                       HorizontalAlignment="{Binding SenderAlignment}"/>
                            <Border Background="{Binding BubbleBackground}"
                                    CornerRadius="{Binding BubbleCornerRadius}"
                                    Padding="10,6"
                                    Margin="{Binding BubbleMargin}"
                                    HorizontalAlignment="{Binding BubbleAlignment}"
                                    MaxWidth="320">
                                <TextBox Text="{Binding Content, Mode=OneTime}"
                                         Foreground="{Binding TextForeground}"
                                         FontFamily="{Binding TextFont}"
                                         TextWrapping="Wrap"
                                         FontSize="13"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0"
                                         AcceptsReturn="True"
                                         Cursor="IBeam">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="复制"
                                                      Command="{x:Static ApplicationCommands.Copy}"
                                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="全选"
                                                      Command="{x:Static ApplicationCommands.SelectAll}"
                                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Typing indicator -->
        <Border x:Name="TypingIndicator"
                Style="{StaticResource ThemedCardBorder}"
                Grid.Row="1"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                Margin="8,0,0,4"
                Padding="10,4"
                CornerRadius="8"
                BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock Text="OpenCopilot is thinking…"
                       Style="{StaticResource ThemedTypingIndicatorText}"/>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"
                BorderBrush="{StaticResource ThemedBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Expander Grid.Row="0" Header="AI 下一步计划" IsExpanded="False" Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" FontSize="11" Margin="0,0,0,6">
                    <Border Style="{StaticResource ThemedCardBorder}" Margin="0,6,0,0" BorderThickness="1" CornerRadius="4" Padding="6">
                        <ItemsControl x:Name="PlanList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource ThemedPrimaryText}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Title, StringFormat=• {0}}"/>
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource ThemedSecondaryText}"
                                                   Margin="8,0,0,0"
                                                   Text="{Binding Status}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Expander>

                <Expander Grid.Row="1" Header="AI 修改过的文件" IsExpanded="False" Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" FontSize="11" Margin="0,0,0,6">
                    <Border Style="{StaticResource ThemedCardBorder}" Margin="0,6,0,0" BorderThickness="1" CornerRadius="4" Padding="6">
                        <ItemsControl x:Name="ChangedFilesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Style="{StaticResource ThemedPrimaryText}" FontWeight="SemiBold" Text="{Binding RelativePath}"/>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource ThemedSecondaryText}" Text="{Binding Status}"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource ThemedMutedText}" Margin="8,0,0,0" Text="{Binding IsRetained, StringFormat=保留: {0}}"/>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource ThemedFlatButton}"
                                                    Content="打开差异"
                                                    Margin="8,0,0,0"
                                                    Padding="6,2"
                                                    Click="OpenDiffButton_Click"
                                                    CommandParameter="{Binding RelativePath}"/>
                                            <Button Grid.Column="3"
                                                    Style="{StaticResource ThemedFlatButton}"
                                                    Content="撤销块"
                                                    Margin="6,0,0,0"
                                                    Padding="6,2"
                                                    Click="DiscardHunkButton_Click"
                                                    CommandParameter="{Binding RelativePath}"/>
                                            <Button Grid.Column="4"
                                                    Style="{StaticResource ThemedFlatButton}"
                                                    Content="保留"
                                                    Margin="6,0,0,0"
                                                    Padding="6,2"
                                                    Click="RetainChangedFileButton_Click"
                                                    CommandParameter="{Binding RelativePath}"/>
                                            <Button Grid.Column="5"
                                                    Style="{StaticResource ThemedFlatButton}"
                                                    Content="撤销"
                                                    Margin="6,0,0,0"
                                                    Padding="6,2"
                                                    Click="DiscardChangedFileButton_Click"
                                                    CommandParameter="{Binding RelativePath}"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Expander>

                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Style="{StaticResource ThemedFlatButton}"
                            Content="活动文档"
                            Padding="8,2"
                            FontSize="11"
                            Click="AttachActiveDocumentButton_Click"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource ThemedFlatButton}"
                            Content="选择文件"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            FontSize="11"
                            Click="AttachFileButton_Click"/>
                    <TextBlock Grid.Column="2"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource ThemedMutedText}"
                               FontSize="11"
                               Text="支持 Ctrl+V 粘贴剪贴板图片"/>
                </Grid>

                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                    <ItemsControl x:Name="AttachmentList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ThemedCardBorder}" BorderThickness="1" CornerRadius="12" Margin="0,0,6,6" Padding="8,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource ThemedPrimaryText}" Text="{Binding DisplayName}"/>
                                        <Button Style="{StaticResource ThemedFlatButton}" Content="×"
                                                Margin="6,0,0,0"
                                                Padding="4,0"
                                                Click="RemoveAttachmentButton_Click"
                                                CommandParameter="{Binding DisplayName}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox"
                             Grid.Column="0"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinLines="5"
                             MaxLines="10"
                             VerticalScrollBarVisibility="Auto"
                             Padding="8,6"
                             FontSize="13"
                             PreviewKeyDown="InputBox_PreviewKeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource ThemedInputTextBox}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="描述需求、附加上下文或粘贴图片… (Shift+Enter 换行，Enter 发送)"
                                                                   Foreground="{StaticResource ThemedPlaceholderBrush}"
                                                                   FontSize="12"
                                                                   Margin="8,8,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <Grid Grid.Row="5" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OptionsButton"
                            Grid.Column="0"
                            Style="{StaticResource ThemedFlatButton}"
                            Content="⚙"
                            Width="28"
                            Height="24"
                            Padding="0"
                            Margin="0,0,8,0"
                            FontSize="12"
                            ToolTip="打开 OpenCopilot 配置"
                            Click="OptionsButton_Click"/>
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource ThemedPrimaryText}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"
                               FontSize="13"
                               Text="🤖"/>
                    <ComboBox x:Name="ModeSelector"
                              Grid.Column="2"
                              Style="{StaticResource ThemedSelectorComboBox}"
                              MinWidth="88"
                              Margin="0,0,8,0"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="ModeSelector_SelectionChanged"
                              FontSize="11"
                              Padding="4,2"/>
                    <ComboBox x:Name="ProviderSelector"
                              Grid.Column="3"
                              Style="{StaticResource ThemedSelectorComboBox}"
                              MinWidth="108"
                              Margin="0,0,8,0"
                              SelectionChanged="ProviderSelector_SelectionChanged"
                              FontSize="11"
                              ToolTip="选择服务商"
                              Padding="4,2"/>
                    <ComboBox x:Name="ModelSelector"
                              Grid.Column="4"
                              Style="{StaticResource ThemedSelectorComboBox}"
                              MinWidth="140"
                              Margin="0,0,8,0"
                              SelectionChanged="ModelSelector_SelectionChanged"
                              FontSize="11"
                              ToolTip="选择模型"
                              Padding="4,2"/>
                    <Button x:Name="SendButton"
                            Grid.Column="5"
                            Content="发送"
                            MinWidth="52"
                            Height="24"
                            Padding="10,2"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Cursor="Hand"
                            IsDefault="True"
                            Click="SendButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
